# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit real tokens.
# Everything here is optional; values set here override config.yaml.

MIN_TRADE_SIZE=500
CHECK_INTERVAL=30

# Telegram alerts (both needed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord alerts
DISCORD_WEBHOOK_URL=

# whale_of_day.py only: chat or channel to post the daily summary to
# (falls back to TELEGRAM_CHAT_ID)
WHALE_CHANNEL_ID=

# Override the Data API base URL (for example a mirror you run yourself)
# POLYMARKET_API_URL=https://data-api.polymarket.com/v2
